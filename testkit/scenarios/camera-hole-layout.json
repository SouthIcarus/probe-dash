{
  "id": "camera-hole-layout",
  "title": "The score and best line stay clear of the S26 camera hole at 411x891 and 360x780, and under a deeper cut-out",
  "covers": ["A-06", "FEEL-11"],
  "profile": { "size": [411, 891], "dpr": 2.628, "topInsetPx": 84, "seed": 42 },
  "setup": { "save": { "bestDistance": 60 } },
  "steps": [
    { "do": "tap", "text": "PLAY" },
    { "do": "wait_state", "path": "ui.screen", "eq": "game", "timeoutMs": 2000 },
    { "do": "advance", "ms": 100 },
    { "do": "expect", "path": "game.screen.w", "eq": 411 },
    { "do": "expect", "path": "game.hud.insetTop", "gte": 31 },
    { "do": "expect", "path": "game.hud.clearOfInset", "gte": 8, "why": "HUD top = max(5% of height, inset + 8 dp)" },
    { "do": "shot", "name": "411x891" },
    { "do": "back" },
    { "do": "wait_state", "path": "ui.screen", "eq": "home", "timeoutMs": 2000 },
    { "do": "set_profile", "size": [360, 780], "dpr": 3, "topInsetPx": 84 },
    { "do": "tap", "text": "PLAY" },
    { "do": "wait_state", "path": "ui.screen", "eq": "game", "timeoutMs": 2000 },
    { "do": "advance", "ms": 100 },
    { "do": "expect", "path": "game.screen.w", "eq": 360 },
    { "do": "expect", "path": "game.hud.insetTop", "gte": 27 },
    { "do": "expect", "path": "game.hud.clearOfInset", "gte": 8 },
    { "do": "shot", "name": "360x780" },
    { "do": "back" },
    { "do": "wait_state", "path": "ui.screen", "eq": "home", "timeoutMs": 2000 },
    { "do": "set_profile", "size": [411, 891], "dpr": 2.628, "topInsetPx": 150 },
    { "do": "tap", "text": "PLAY" },
    { "do": "wait_state", "path": "ui.screen", "eq": "game", "timeoutMs": 2000 },
    { "do": "advance", "ms": 100 },
    { "do": "expect", "path": "game.hud.insetTop", "gte": 56 },
    { "do": "expect", "path": "game.hud.clearOfInset", "gte": 8, "why": "a deeper cut-out must push the HUD down: inset + 8 dp" },
    { "do": "shot", "name": "deep-cutout" }
  ]
}
