{
  "id": "full-run-scores-exact",
  "title": "A seeded run that flies 4 gates and picks up 10 crystals is scored exactly once and saved on top of 100 crystals",
  "covers": ["GAME-2", "GAME-6", "A-20"],
  "profile": {"size": [411, 891], "dpr": 2.63, "topInsetPx": 84, "seed": 6},
  "setup": {"save": {"crystals": 100}, "ads": {"rewardedReady": false}},
  "steps": [
    {"do": "tap", "text": "PLAY"},
    {"do": "wait_state", "path": "ui.screen", "eq": "game", "timeoutMs": 2000},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "advance", "ms": 700},
    {"do": "tap_at", "x": 0.5, "y": 0.5},
    {"do": "wait_state", "path": "ui.overlay", "eq": "results", "timeoutMs": 4000},
    {"do": "expect", "path": "game.gatesPassed", "eq": 4, "why": "seed 6 and a tap every 700 ms passes four gates"},
    {"do": "expect", "path": "game.nearMisses", "eq": 1},
    {"do": "expect", "path": "game.crystals", "eq": 10, "why": "8 pickups worth 1 and one near miss worth 2"},
    {"do": "expect", "path": "game.distanceM", "eq": 153},
    {"do": "expect", "path": "progress.crystals", "eq": 110, "why": "100 saved + 10 earned, added once"},
    {"do": "expect", "path": "progress.bestM", "eq": 153},
    {"do": "expect", "path": "progress.runs", "eq": 1},
    {"do": "expect", "path": "progress.interstitialsShown", "eq": 0}
  ]
}
