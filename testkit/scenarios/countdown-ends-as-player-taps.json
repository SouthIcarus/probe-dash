{
  "id": "countdown-ends-as-player-taps",
  "title": "The revive countdown ends in the same moment the player taps No thanks: counted once",
  "covers": ["A-20", "UX-21"],
  "profile": { "size": [411, 891], "dpr": 2.63, "topInsetPx": 84, "seed": 42 },
  "setup": { "save": "fixtures/fresh.json", "ads": { "rewardedReady": true } },
  "steps": [
    { "do": "tap", "text": "PLAY" },
    { "do": "wait_state", "path": "ui.screen", "eq": "game", "timeoutMs": 2000 },
    { "do": "tap_at", "x": 0.5, "y": 0.5 },
    { "do": "wait_state", "path": "ui.overlay", "eq": "revive", "timeoutMs": 15000 },
    { "do": "wait_state", "path": "ui.countdown", "eq": 1, "timeoutMs": 6000 },
    { "do": "tap", "text": "No thanks" },
    { "do": "advance", "ms": 1500 },
    { "do": "expect", "path": "progress.runs", "eq": 1, "why": "tap and countdown must not apply the run twice" },
    { "do": "expect", "path": "ui.overlay", "eq": "results" },
    { "do": "expect_text", "text": "PLAY AGAIN", "count": 1 }
  ]
}
